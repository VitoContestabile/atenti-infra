# =========================================
# NOTA DE FORMATO — LEER ANTES DE EDITAR
# =========================================
# scripts/deploy.sh hace `source .env` con `set -e`.
# Todo valor que contenga < > espacios, # o comillas DEBE ir entre
# comillas dobles, o bash lo interpreta como sintaxis y el deploy muere.
#
#   MAL:  MAIL_FROM=Atenzia <no-reply@atenzia.local>   <- el "<" es una redirección
#   BIEN: MAIL_FROM="Atenzia <no-reply@atenzia.local>"
#
# Verificar siempre antes de deployar:
#   ( set -a; source .env; set +a; echo ok )

# =========================================
# DATABASE
# =========================================

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# La que usa Prisma. Mismos datos que arriba, host "database":
# postgresql://user:pass@database:5432/app
DATABASE_URL=

# =========================================
# STORAGE (S3)
# =========================================

STORAGE_PROVIDER=aws
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BUCKET_NAME=

# =========================================
# AUTH
# =========================================
# Claves de firma de tokens. Sin estas el backend no arranca.
# Generarlas con `npm run auth:generate-keys` en backend/ de lab3-atenti.
# Van entre comillas dobles, en una sola línea.

AUTH_PQ_PRIVATE_KEY=""
AUTH_PQ_PUBLIC_KEY=""
# Segundos
AUTH_TOKEN_TTL=

# =========================================
# DOMAIN / HTTPS
# =========================================

DOMAIN_NAME=
CERTBOT_EMAIL=

# =========================================
# GITHUB CONTAINER REGISTRY
# =========================================

GHCR_USER=
GHCR_PAT=

# =========================================
# MAIL
# =========================================
# Con MAIL_ENABLED=true tiene que haber un SMTP escuchando en MAIL_HOST:MAIL_PORT.
# El docker-compose NO levanta ninguno.
# APP_BASE_URL es la base del link de desbloqueo que va en los mails.

MAIL_ENABLED=
APP_BASE_URL=
# Entre comillas: contiene < >
MAIL_FROM=""
MAIL_HOST=
MAIL_PORT=
MAIL_SECURE=
MAIL_USER=
MAIL_PASSWORD=
