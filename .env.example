# =========================================
# NOTA DE FORMATO — LEER ANTES DE EDITAR
# =========================================
# scripts/deploy.sh hace `source .env` con `set -e`.
# Todo valor que contenga < > espacios, # o comillas DEBE ir entre
# comillas dobles, o bash lo interpreta como sintaxis y el deploy muere.
#
#   MAL:  MAIL_FROM=Atenzia <no-reply@atenzia.local>   <- el "<" es una redirección
#   BIEN: MAIL_FROM="Atenzia <no-reply@atenzia.local>"
#
# Verificar siempre antes de deployar:
#   ( set -a; source .env; set +a; echo ok )

# =========================================
# DATABASE
# =========================================

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# URL interna docker
DOCKER_DATABASE_URL=
# La que usa Prisma (schema.prisma lee env("DATABASE_URL")).
# Apunta al host del contenedor: postgresql://user:pass@database:5432/app
DATABASE_URL=

# =========================================
# MINIO
# =========================================

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Backend
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
STORAGE_PROVIDER=

# =========================================
# APPLICATION
# =========================================

NODE_ENV=
PORT=

# =========================================
# DOMAIN / HTTPS
# =========================================

DOMAIN_NAME=
CERTBOT_EMAIL=

# =========================================
# GITHUB CONTAINER REGISTRY
# =========================================

GHCR_USER=
GHCR_PAT=

# =========================================
# FRONTEND
# =========================================

FRONTEND_URL=

# =========================================
# BACKEND
# =========================================

BACKEND_URL=

# =========================================
# MAIL
# =========================================
# Con MAIL_ENABLED=true tiene que haber un SMTP escuchando en MAIL_HOST:MAIL_PORT.
# El docker-compose NO levanta ninguno.

MAIL_ENABLED=
MAIL_HOST=
MAIL_PORT=
# Entre comillas: contiene < >
MAIL_FROM=""

# =========================================
# AUTH
# =========================================
# Claves de firma de tokens. Sin estas el backend no arranca.
# Son multilinea/base64 largas: van entre comillas dobles, en una sola línea.

AUTH_PQ_PRIVATE_KEY=""
AUTH_PQ_PUBLIC_KEY=""
# Segundos
AUTH_TOKEN_TTL=
